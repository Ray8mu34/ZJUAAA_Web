{
  "version": "2.0",
  "purpose": "二十款现有插画中的原栏目落位；没有新增导航文案。",
  "coordinateSystem": {
    "origin": "原图左上角",
    "xY": "groups.x/y 为文字组中心，占实际图宽/图高的比例，不是占外部容器的比例。",
    "maxWidth": "允许占据的图宽比例；widthPx 是1440px宽原图下的目标文字组宽。",
    "referenceWidthPx": 1440,
    "fontSizePx": 16,
    "fontFamily": "沿用原站无衬线导航字体",
    "ink": {
      "dark": "#142C42",
      "light": "#FFFFFF"
    },
    "groupLayout": "row单行；compact固定列数网格；split由多个row/compact组组成。每组items严格使用原八栏目索引与原主题按钮。",
    "scale": "展示落位图时图与文字共同等比缩放；实际网页不把16px文字随窗口无限缩小，空间不足时依实际留白改成紧凑排布。",
    "rowHeightPx": 44,
    "rowHeightMeaning": "透明点击区的行高；不绘制背景或边框。"
  },
  "linkOrder": [
    "主页",
    "知识科普",
    "社团活动",
    "天文摄影",
    "天文手册",
    "内部资料",
    "关于我们",
    "联系我们"
  ],
  "theme": "theme表示原主题切换按钮，只画既有图标，不新增文字。",
  "sourceBoundary": "本表依据用户截图及其无重排裁切图，属于设计落点初值；不能等同原SVG精标，也不能保证未知的手机SVG裁切自动保留这些位置。",
  "globalRules": [
    "八个原栏目和主题按钮直接可见。",
    "不加副标题、序号、英文、圆点、边框、背景条或装饰线。",
    "不移动、放大、重排或重画插画来迁就导航。",
    "人物、望远镜、日月、桥、建筑、主要路径和树的关键轮廓不被覆盖。",
    "对比度依据文字实际落点及底部蒙版合成结果检查；同一词不跨越明暗色边。",
    "02是主原型；其他19款是落位图与原稿接入依据。"
  ],
